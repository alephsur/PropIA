# ── IA — Proveedor activo ────────────────────────────
# Opciones: anthropic | openrouter | groq | ollama
AI_PROVIDER=ollama
# Modelo a usar (vacío = modelo por defecto del proveedor)
AI_MODEL=

# Fallback automático cuando el proveedor principal alcanza el límite de uso
# Vacío = sin fallback. Recomendado: si AI_PROVIDER=groq → AI_PROVIDER_FALLBACK=openrouter
AI_PROVIDER_FALLBACK=openrouter
# Modelo para el fallback (vacío = modelo por defecto del proveedor fallback)
AI_MODEL_FALLBACK=

# ── IA — Anthropic ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings — Ollama (local, sin API key) ─────────
# Ollama corre en Docker, no requiere API key
# El modelo se descarga automáticamente en el primer uso
# OLLAMA_BASE_URL=http://ollama:11434
# EMBEDDING_MODEL=mxbai-embed-large

# ── LLM local — Ollama ───────────────────────────────
# Modelo Ollama para inferencia LLM (análisis de documentos, PGOU, etc.)
# Sin límite de tokens, sin coste. Requiere que el modelo esté descargado en Ollama.
# Recomendados: qwen2.5:7b (por defecto, ~5 GB VRAM, rápido), qwen2.5:14b (más calidad), llama3.2
OLLAMA_LLM_MODEL=qwen2.5:7b

# ── RAG PGOU — modo rápido para LLMs locales ─────────
# true = desactiva query expansion + LLM rerank y usa top_k=6 (1 sola llamada al LLM por consulta)
PGOU_FAST_MODE=true
PGOU_FAST_TOP_K=6

# ── Proveedor exclusivo para el módulo de documentos ─
# Vacío = usa AI_PROVIDER. Recomendado: "ollama" para documentos grandes sin límites de tokens.
AI_PROVIDER_DOCUMENTOS=ollama
AI_MODEL_DOCUMENTOS=

# ── IA — OpenRouter ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── IA — Groq ────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Base de datos ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propia:propia@db:5432/propia

# ── Servidor ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG

# ── Almacenamiento PDFs ──────────────────────────────
STORAGE_PATH=./storage/docs
MAX_PDF_SIZE_MB=100

# ── Rate limiting ────────────────────────────────────
RATE_CATASTRO=60
RATE_URBANISMO=30
RATE_DOCUMENTOS=10
RATE_BIBLIOTECA=20
