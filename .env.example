# ── IA — Proveedor activo ────────────────────────────
# Opciones: anthropic | openrouter | groq
AI_PROVIDER=anthropic
# Modelo a usar (vacío = modelo por defecto del proveedor)
AI_MODEL=

# ── IA — Anthropic ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings — Ollama (local, sin API key) ─────────
# Ollama corre en Docker, no requiere API key
# El modelo se descarga automáticamente en el primer uso
# OLLAMA_BASE_URL=http://ollama:11434
# EMBEDDING_MODEL=mxbai-embed-large

# ── IA — OpenRouter ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── IA — Groq ────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Base de datos ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propia:propia@db:5432/propia

# ── Servidor ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG

# ── Almacenamiento PDFs ──────────────────────────────
STORAGE_PATH=./storage/docs
MAX_PDF_SIZE_MB=100

# ── Rate limiting ────────────────────────────────────
RATE_CATASTRO=60
RATE_URBANISMO=30
RATE_DOCUMENTOS=10
RATE_BIBLIOTECA=20
