# ── IA ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# ── Base de datos ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propia:propia@db:5432/propia

# ── Servidor ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG

# ── Almacenamiento PDFs ──────────────────────────────
STORAGE_PATH=./storage/docs
MAX_PDF_SIZE_MB=100

# ── Rate limiting ────────────────────────────────────
RATE_CATASTRO=60
RATE_URBANISMO=30
RATE_DOCUMENTOS=10
RATE_BIBLIOTECA=20
